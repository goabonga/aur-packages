# Kconfig fragment merged over Arch's linux-hardened configuration.
#
# The GPD Pocket 1 (Intel Atom x7-Z8750, Cherry Trail) wires its USB-C
# port to the SoC's DesignWare USB3 controller, which is dual-role
# capable. Arch's stock kernels build it host-only, so the port can never
# act as a device. These options turn the controller's device side on and
# give it the role-detection and function drivers to be useful.
#
# Applied by prepare() with scripts/kconfig/merge_config.sh, then
# reconciled with `make olddefconfig`. Anything the kernel refuses will
# show up in the diff prepare() prints.

# --- Dual-role controller -------------------------------------------------
# DWC3 must be dual-role, not host-only, and the PCI glue is how it is
# enumerated on Cherry Trail.
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_PCI=m
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y

# --- Role detection -------------------------------------------------------
# On Cherry Trail the Whiskey Cove PMIC reports cable orientation and
# host/device role over its extcon interface. Without it the port stays in
# whatever role it booted in.
CONFIG_INTEL_SOC_PMIC_CHTWC=y
CONFIG_EXTCON_INTEL_CHT_WC=m
CONFIG_TYPEC=m
CONFIG_TYPEC_TCPM=m
CONFIG_TYPEC_FUSB302=m

# --- Gadget core ----------------------------------------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m

# --- Gadget functions -----------------------------------------------------
# The ones worth having on a pocket machine: serial console, ethernet over
# USB both ways, mass storage, HID, and raw FunctionFS for anything else.
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_FS=y
