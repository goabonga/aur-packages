pkgname = linux-hardened-usbgadget
	pkgdesc = The Security-Hardened Linux with USB dual-role and gadget support kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-hardened-usbgadget-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE

pkgname = linux-hardened-usbgadget-headers
	pkgdesc = Headers and scripts for building modules for the Security-Hardened Linux with USB dual-role and gadget support kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
